# Copie para .env no servidor de produção (cp .env.example .env) e preencha.
# Nunca versione o .env.

# Domínio que aponta para o servidor (registro A no DNS). Sem https://
DOMINIO=financas.seu-dominio.com
# E-mail para o Let's Encrypt avisar sobre o certificado (obrigatório)
EMAIL_ACME=voce@exemplo.com

# Gere com: openssl rand -hex 32
DJANGO_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
# Gere com: openssl rand -hex 24 (só letras e números, porque entra numa URL)
POSTGRES_PASSWORD=troque-esta-senha

# Backups do banco: pasta no servidor, quantos dias guardar e a hora do dia
BACKUP_PASTA=./backups
BACKUP_DIAS=14
BACKUP_HORA=03
