# Copie para .env no servidor de produção (cp .env.example .env) e preencha.
# Nunca versione o .env.

# Subdomínio publicado pelo túnel do Cloudflare. Sem https://
DOMINIO=financas.rlcsolucoes.com.br
# Porta local (só 127.0.0.1) onde o app escuta. Escolha uma livre no servidor.
PORTA=8090

# Gere com: openssl rand -hex 32
DJANGO_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
# Gere com: openssl rand -hex 24 (só letras e números, porque entra numa URL)
POSTGRES_PASSWORD=troque-esta-senha

# Só se o túnel rodar dentro deste compose (--profile tunel)
CLOUDFLARE_TUNNEL_TOKEN=

# Backups do banco: pasta no servidor, quantos dias guardar e a hora do dia
BACKUP_PASTA=./backups
BACKUP_DIAS=14
BACKUP_HORA=03
